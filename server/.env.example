# 1) Paste your MongoDB Atlas connection string below (keep the database name "quickbite")
# 2) In Atlas: Network Access -> Add IP Address -> Allow access from anywhere (0.0.0.0/0)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/quickbite?retryWrites=true&w=majority
PORT=5000
ADMIN_KEY=quickbite-admin
CLIENT_ORIGIN=http://localhost:5173
